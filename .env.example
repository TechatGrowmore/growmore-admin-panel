# Environment Variables — Root Reference
# Copy to backend/.env for local development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/growmore_admin?retryWrites=true&w=majority

# ─── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# Generate the hash:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_PASSWORD_HASH=

# ─── Security ─────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=growmore-admin-secret-change-me-in-production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production
# e.g. https://growmore-admin.onrender.com
FRONTEND_URL=

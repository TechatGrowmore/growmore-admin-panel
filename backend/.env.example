# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb://growwmoreadmin_db_user:njmW2PBDACkbTGLS@ac-iebvvf7-shard-00-00.1ozzoes.mongodb.net:27017,ac-iebvvf7-shard-00-01.1ozzoes.mongodb.net:27017,ac-iebvvf7-shard-00-02.1ozzoes.mongodb.net:27017/?ssl=true&replicaSet=atlas-8ij5zw-shard-0&authSource=admin&appName=Growmore

# Admin credentials
ADMIN_USERNAME=admin
# SHA-256 hash of your password. Generate with:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_PASSWORD_HASH=

# JWT secret - use a long random string in production
ADMIN_JWT_SECRET=growmore-admin-secret-change-me-in-production

# HR/Accountant JWT secret
HR_JWT_SECRET=growmore-hr-secret-change-me-in-production

# Driver JWT secret
DRIVER_JWT_SECRET=growmore-driver-secret-change-me-in-production

# Default HR credentials (auto-seeded on startup)
# HR:         username=hr        password=hr@growmore
# Accountant: username=accountant password=accountant@growmore

# Cloudinary (add after getting from cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port for the server (Render sets this automatically)
PORT=5000

# URL of the deployed frontend (used for CORS). In production, set to your Render URL.
FRONTEND_URL=

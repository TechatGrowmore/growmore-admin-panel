# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/growmore_admin?retryWrites=true&w=majority

# Admin credentials
ADMIN_USERNAME=admin
# SHA-256 hash of your password. Generate with:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_PASSWORD_HASH=

# JWT secret - use a long random string in production
ADMIN_JWT_SECRET=growmore-admin-secret-change-me-in-production

# Port for the server (Render sets this automatically)
PORT=5000

# URL of the deployed frontend (used for CORS). In production, set to your Render static site URL.
# In dev, leave empty to allow localhost:5173
FRONTEND_URL=
